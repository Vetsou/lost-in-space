; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LostInSpace"
run/main_scene="uid://cpvqj17edxl8f"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")

[autoload]

ConfigManager="*uid://bx77vbmun6u38"

[dotnet]

project/assembly_name="LostInSpace"
project/solution_directory="../"

[internationalization]

